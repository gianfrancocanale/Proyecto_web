package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } | PredictOne</title>
			<link rel="stylesheet" href="/principal.css"/>
		</head>
		<body>
			<header class="navbar">
				<a href="/" class="logo">Predict<span>One</span></a>
				<nav class="nav-auth">
					<a href="/ingresar.html" class="btn-login">Iniciar sesión</a>
					<a href="/registrar.html" class="btn-register">Registrarse</a>
				</nav>
			</header>
			<main class="page-container">
				{ children... }
			</main>
			<footer class="footer">
				<a href="/" class="logo">Predict<span>One</span></a>
				<p>LA FÓRMULA 1, MÁS CERCA DE VOS</p>
			</footer>
		</body>
	</html>
}