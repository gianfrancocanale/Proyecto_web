package views

templ IndexPage() {
	@Layout("Inicio") {
		<section class="hero">
			<div class="hero-content">
				<p class="eyebrow">ANALIZÁ · PREDICÍ · VIVÍ LA F1</p>
				<h1>Bienvenido a <span>PredictOne</span></h1>
				<p class="hero-description">
					La mejor información de la Fórmula 1 en un solo lugar.
					Conocé las escuderías, los pilotos y todos los grandes
					premios de la temporada.
				</p>
			</div>
		</section>
		<section class="explore">
			<div class="section-heading">
				<h2>Explorá el mundo de la <span>Fórmula 1</span></h2>
				<p>
					Descubrí toda la información que necesitás sobre
					las escuderías, pilotos y grandes premios.
				</p>
			</div>
			<div class="cards">
				<article class="card">
					<div class="card-image escuderias-image"></div>
					<div class="card-content">
						<h3>Escuderías</h3>
						<p>Conocé el rendimiento de cada equipo, sus pilotos y puntos en el campeonato.</p>
						<a href="/web/escuderias" class="card-link">Ver escuderías →</a>
					</div>
				</article>
				<article class="card">
					<div class="card-image pilotos-image"></div>
					<div class="card-content">
						<h3>Pilotos</h3>
						<p>Descubrí los pilotos, sus estadísticas, resultados y trayectoria en la F1.</p>
						<a href="/web/pilotos" class="card-link">Ver pilotos →</a>
					</div>
				</article>
				<article class="card">
					<div class="card-image premios-image"></div>
					<div class="card-content">
						<h3>Grandes Premios</h3>
						<p>Explorá circuitos, calendarios e información histórica de las carreras.</p>
						<a href="/web/gran_premios" class="card-link">Ver grandes premios →</a>
					</div>
				</article>
			</div>
		</section>
	}
}