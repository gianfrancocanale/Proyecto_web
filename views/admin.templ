package views

import "strconv"

type AdminData struct {
	Aviso      string
	Mensaje    string
	Circuitos  []string
	Pendientes []OpcionGP
	Pilotos    []OpcionPiloto
}

templ AdminPage(d AdminData) {
	@LayoutAdmin("Administración") {
		<div class="page-header">
			<h1>Panel de <span>administración</span></h1>
			<p>Programá carreras y cargá resultados.</p>
		</div>
		if d.Aviso != "" {
			<div class="alert-ok">{ d.Aviso }</div>
		}
		if d.Mensaje != "" {
			<div class="alert-error">{ d.Mensaje }</div>
		}
		<div class="bets-layout">
			<div class="auth-box">
				<h2>Programar <span>carrera</span></h2>
				<p class="auth-subtitle">Queda abierta para apostar</p>
				<form method="post" action="/admin/carrera" class="auth-form">
					<div class="form-group">
						<label for="circuito">Circuito</label>
						<select id="circuito" name="circuito" required>
							for _, c := range d.Circuitos {
								<option value={ c }>{ c }</option>
							}
						</select>
					</div>
					<div class="form-group">
						<label for="fecha">Fecha de la carrera</label>
						<input type="date" id="fecha" name="fecha" required/>
					</div>
					<button type="submit" class="btn-submit">Programar</button>
				</form>
			</div>
			<div class="auth-box bet-form-box">
				<h2>Cargar <span>resultado</span></h2>
				<p class="auth-subtitle">Orden de llegada de los 22 pilotos. Reparte los puntos de las apuestas y no se puede deshacer.</p>
				if len(d.Pendientes) == 0 {
					<p class="auth-subtitle">No hay carreras pendientes de resultado.</p>
				} else {
					<form method="post" action="/admin/resultado" class="auth-form">
						<div class="form-group">
							<label for="edicion">Carrera</label>
							<select id="edicion" name="edicion" required>
								for _, e := range d.Pendientes {
									<option value={ e.Valor }>{ e.Texto }</option>
								}
							</select>
						</div>
						<div class="positions-form">
							for i := range 22 {
								<div class="position-row">
									<span class="position-number">P{ strconv.Itoa(i + 1) }</span>
									<select name="piloto" required>
										<option value="">Elegí un piloto</option>
										for _, p := range d.Pilotos {
											<option value={ strconv.Itoa(p.ID) }>{ p.Nombre }</option>
										}
									</select>
								</div>
							}
						</div>
						<button type="submit" class="btn-submit">Cargar resultado</button>
					</form>
				}
			</div>
		</div>
	}
}