package views

import (
	"fmt"
	d "Proyecto_web/db/sqlc"
)

templ PilotosPage(pilotos []d.ListarPilotosRow, orden string) {
	@Layout("Pilotos") {
		<div class="page-container">
			<div class="page-header">
				<h1>Pilotos <span>2026</span></h1>
				<p>La parrilla completa de la temporada 2026.</p>

				<div class="filter-container" style="margin-top: 1.5rem;">
                    if orden == "asc" {
                        <a href="pilotos?orden=desc" class="btn-register">Ordenado: Menor a Mayor (Puntos Temporada) ⇅</a>
                    } else {
                        <a href="/pilotos?orden=asc" class="btn-register">Ordenado: Mayor a Menor (Puntos Temporada) ⇅</a>
                    }
                </div>
			</div>
			<div class="grid-content">
				for _, p := range pilotos {
					<article class="data-card driver-card">
						<div class="driver-img-box">
							<img
								src={ fmt.Sprintf("/front/imagenes/pilotos/%d.jpg", p.IDPiloto) }
								alt={ p.Nombre }
								onerror="this.onerror=null; this.src='/front/imagenes/pilotos/default.jpg';"
							/>
						</div>
						<span class="driver-number">{ fmt.Sprint(p.IDPiloto) }</span>
						<div class="data-card-header">
							<h3>{ p.Nombre }</h3>
							<p class="driver-team">{ p.IDEscuderia }</p>
						</div>
						<div class="data-card-body">
							<p><strong>País:</strong> { p.Pais }</p>
							<p><strong>Fecha de Nacimiento:</strong> { p.FechaNacimiento.Format("02/01/2006")}</p>
							<p><strong>Títulos Ganados:</strong> { p.TitulosGanados }</p>
							<p class="points">{ fmt.Sprint(p.PuntosTemporada) } pts</p>
						</div>
					</article>
				}
			</div>
		</div>
	}
}