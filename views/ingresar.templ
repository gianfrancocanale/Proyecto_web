package views

templ IngresarPage(errorMsg string) {
	@Layout("Ingresar") {
		<section class="auth-container">
			<form method="POST" action="/ingresar" class="auth-form">
				<h1>Iniciar <span>sesión</span></h1>
				<p class="auth-subtitle">Ingresá para ver toda la información de la F1.</p>
				if errorMsg != "" {
					<p class="form-error">{ errorMsg }</p>
				}
				<label for="nombre_usuario">Nombre de usuario</label>
				<input type="text" id="nombre_usuario" name="nombre_usuario" required autocomplete="username"/>
				<label for="contraseña">Contraseña</label>
				<input type="password" id="contraseña" name="contraseña" required autocomplete="current-password"/>
				<button type="submit" class="btn-register">Ingresar</button>
				<p class="auth-alt">¿No tenés cuenta? <a href="/registrar">Registrate</a></p>
			</form>
		</section>
	}
}