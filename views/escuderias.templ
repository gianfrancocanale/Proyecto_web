package views

import (
	"fmt"
	d "Proyecto_web/db/sqlc"
)

templ EscuderiasPage(escuderias []d.Escuderium) {
	@Layout("Escuderías") {
		<div class="page-container">
			<div class="page-header">
				<h1>Escuderías <span>2026</span></h1>
				<p>Todos los equipos de la temporada.</p>
			</div>
			<div class="grid-content teams-grid">
				for _, e := range escuderias {
					<article class="data-card">
							<div class="team-img-box">
								<img
									src={ "/imagenes/" + e.IDEscuderia + ".jpg" }
									alt={ e.IDEscuderia }
									onerror="this.parentElement.style.display='none'"
								/>
							</div>
						<div class="data-card-header">
							<span class="badge">Escudería</span>
							<h3>{ e.IDEscuderia }</h3>
						</div>
						<div class="data-card-body">
							<p><strong>TeamPrincipal:</strong> { e.TeamPrincipal }</p>
							<p><strong>Titulo de constructores:</strong> { e.TitulosConstructores }</p>
							<p><strong>Fecha de fundación:</strong> { e.FechaFundacion.Format("02/01/2006") }</p>
							<p class="points">{ fmt.Sprint(e.PuntosTemporada) } pts</p>
						</div>
					</article>
				}
			</div>
		</div>
	}
}