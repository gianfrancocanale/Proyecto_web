package views

templ RegistrarPage(errorMsg string) {
	@Layout("Registrarse") {
		<section class="auth-container">
			<form method="POST" action="/registrar" class="auth-form">
				<h1>Crear <span>cuenta</span></h1>
				<p class="auth-subtitle">Registrate para empezar a predecir.</p>
				if errorMsg != "" {
					<p class="form-error">{ errorMsg }</p>
				}
				<label for="nombre_usuario">Nombre de usuario</label>
				<input
					type="text"
					id="nombre_usuario"
					name="nombre_usuario"
					required
					maxlength="50"
					autocomplete="username"
				/>
				<label for="contraseña">Contraseña</label>
				<input
					type="password"
					id="contraseña"
					name="contraseña"
					required
					minlength="6"
					autocomplete="new-password"
				/>
				<button type="submit" class="btn-register">Registrarse</button>
				<p class="auth-alt">¿Ya tenés cuenta? <a href="/ingresar">Iniciá sesión</a></p>
			</form>
		</section>
	}
}