package views

templ RegistrarPage(mensaje string) {
	@Layout("Registrarse") {
		<section class="register">
			<div class="register-header">
				<span class="register-badge">NUEVA CUENTA</span>
				<h1>Sumate a <span>PredictOne</span></h1>
				<p>Creá tu cuenta en menos de un minuto</p>
			</div>
			if mensaje != "" {
				<div class="alert-error">{ mensaje }</div>
			}
			<form method="post" class="register-form">
				<div class="form-group full">
					<label for="nombre_usuario">Nombre de usuario</label>
					<input type="text" id="nombre_usuario" name="nombre_usuario" placeholder="tu_usuario" required/>
				</div>
				<div class="form-group">
					<label for="contraseña">Contraseña</label>
					<input type="password" id="contraseña" name="contraseña" placeholder="••••••••" required/>
				</div>
				<button type="submit" class="btn-submit full">Crear cuenta</button>
			</form>
			<ul class="register-perks">
				<li><strong>Top 10</strong><span>Armá tu pronóstico por carrera</span></li>
				<li><strong>Gratis</strong><span>Sin costos ni tarjetas</span></li>
				<li><strong>Rápido</strong><span>Listo en un minuto</span></li>
			</ul>
			<p class="auth-footer-text">¿Ya tenés cuenta? <a href="/ingresar">Iniciá sesión</a></p>
		</section>
	}
}